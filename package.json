{
  "name": "og-moomoo.io",
  "version": "1.0.0",
  "description": "A custom MooMoo.io client with a Bun backend",
  "main": "index.js",
  "scripts": {
    "dev": "bun --watch index.ts",
    "build": "bun run bundler.ts",
    "build:watch": "bun --watch bundler.ts .",
    "watch": "bun --watch . --bun \"bun run build\"",
    "start": "nodemon --legacy-watch --watch index.ts --watch bundle --ext ts,js --exec \"bun run build && bun run index.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "CC-BY-NC-4.0",
  "dependencies": {
    "@google/genai": "^1.48.0",
    "@google/generative-ai": "^0.24.1",
    "bun-types": "^1.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "fs": "^0.0.1-security",
    "howler": "^2.2.4",
    "md5": "^2.3.0",
    "msgpack-lite": "^0.1.26",
    "ollama": "^0.6.3",
    "openai": "^6.33.0",
    "synaptic": "^1.1.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.3",
    "nodemon": "^3.1.14",
    "typescript": "^5.3.2"
  }
}
